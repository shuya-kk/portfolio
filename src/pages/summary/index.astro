---
import appsData from "../../data/apps.json";
import Layout from "../../layouts/Layout.astro";

const apps = [...(appsData || [])].sort((a: any, b: any) => (b.downloads || 0) - (a.downloads || 0));

const totalApps = apps.length;
const totalDownloads = apps.reduce((sum: number, app: any) => sum + (app.downloads || 0), 0);
const totalRatings = apps.reduce((sum: number, app: any) => sum + (app.ratingCount || 0), 0);
const totalReviewsCount = apps.reduce((sum: number, app: any) => sum + ((app.reviews || []).length), 0);

// Weighted average rating
const weightedRatingSum = apps.reduce(
    (sum: number, app: any) => sum + (app.rating || 0) * (app.ratingCount || 0),
    0
);
const averageRating = totalRatings > 0 ? weightedRatingSum / totalRatings : 0;

// Country & Global Aggregation
const globalCountryMap = new Map<string, number>();
for (const app of apps) {
    const cObj = app.countries || {};
    for (const [code, count] of Object.entries(cObj)) {
        const num = Number(count) || 0;
        if (num > 0) {
            globalCountryMap.set(code, (globalCountryMap.get(code) || 0) + num);
        }
    }
}
const sortedCountries = [...globalCountryMap.entries()]
    .map(([code, downloads]) => ({ code, downloads }))
    .sort((a, b) => b.downloads - a.downloads);

const totalCountriesCount = sortedCountries.length;
const jpDownloads = globalCountryMap.get("JP") || 0;
const totalTrackedCountryDownloads = sortedCountries.reduce((acc, c) => acc + c.downloads, 0);
const overseasDownloads = Math.max(0, totalTrackedCountryDownloads - jpDownloads);
const overseasSharePct =
    totalTrackedCountryDownloads > 0
        ? ((overseasDownloads / totalTrackedCountryDownloads) * 100).toFixed(1)
        : "0.0";

const countryCodeToFlag = (code?: string) => {
    if (!code || code.length !== 2) return "🌐";
    return Array.from(code.toUpperCase())
        .map((c) => String.fromCodePoint(127397 + c.charCodeAt(0)))
        .join("");
};

const regionNames = new Intl.DisplayNames(["ja"], { type: "region" });
const getCountryName = (code: string) => {
    try {
        return regionNames.of(code.toUpperCase()) || code;
    } catch {
        return code;
    }
};

// Top 10 Apps by Downloads
const topApps = apps.slice(0, 10);
const maxAppDownloads = topApps[0]?.downloads || 1;

// Share distribution (Top 5 + Others) for stacked distribution bar
const top5Apps = apps.slice(0, 5);
const othersDownloads = apps.slice(5).reduce((sum: number, app: any) => sum + (app.downloads || 0), 0);
const palette = [
    "bg-blue-500",
    "bg-indigo-500",
    "bg-violet-500",
    "bg-emerald-500",
    "bg-amber-500",
    "bg-slate-400 dark:bg-slate-600",
];

// Genre aggregation
const genreMap = new Map<string, { count: number; downloads: number; ratings: number }>();
for (const app of apps) {
    const genre = app.genre || "App";
    const cur = genreMap.get(genre) || { count: 0, downloads: 0, ratings: 0 };
    cur.count += 1;
    cur.downloads += app.downloads || 0;
    cur.ratings += app.ratingCount || 0;
    genreMap.set(genre, cur);
}
const genres = [...genreMap.entries()]
    .map(([name, stat]) => ({ name, ...stat }))
    .sort((a, b) => b.downloads - a.downloads || b.count - a.count);

// Release Year aggregation
const yearMap = new Map<string, { count: number; downloads: number; apps: any[] }>();
for (const app of apps) {
    const year = app.releaseDate ? String(new Date(app.releaseDate).getFullYear()) : "その他";
    const cur = yearMap.get(year) || { count: 0, downloads: 0, apps: [] };
    cur.count += 1;
    cur.downloads += app.downloads || 0;
    cur.apps.push(app);
    yearMap.set(year, cur);
}
const yearlyStats = [...yearMap.entries()]
    .filter(([y]) => y !== "その他")
    .map(([year, stat]) => ({ year, ...stat }))
    .sort((a, b) => a.year.localeCompare(b.year));
const maxYearlyCount = Math.max(1, ...yearlyStats.map((y) => y.count));

// Download Tiers (Milestones)
const tiers = [
    { label: "100,000+ DL", count: apps.filter((a: any) => (a.downloads || 0) >= 100000).length, color: "text-amber-500" },
    { label: "10,000+ DL", count: apps.filter((a: any) => (a.downloads || 0) >= 10000 && (a.downloads || 0) < 100000).length, color: "text-blue-500" },
    { label: "1,000+ DL", count: apps.filter((a: any) => (a.downloads || 0) >= 1000 && (a.downloads || 0) < 10000).length, color: "text-emerald-500" },
    { label: "〜999 DL", count: apps.filter((a: any) => (a.downloads || 0) < 1000).length, color: "text-secondary" },
];
---

<Layout title="Summary | SHUYA KOMIYA" description="リリースしたiOSアプリの全世界累計ダウンロード数・国別統計・評価・カテゴリ別サマリー">
    <div class="container-custom pb-32">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-14 md:mb-18 reveal-on-scroll">
            <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full liquid-pill text-xs font-semibold text-accent mb-4">
                    <span>🌐 App Store Connect Global Analytics</span>
                </div>
                <h1 class="heading-hero mb-4">Summary</h1>
                <p class="heading-sub">
                    これまでに個人開発した全 {totalApps} 本の iOS アプリの全世界累計ダウンロード数、世界 {totalCountriesCount} カ国・地域の配信実績、ユーザー評価のグラフィカルな統計サマリーです。
                </p>
            </div>
            <a href="/portfolio/apps" class="btn-apple-secondary text-xs shrink-0">
                <span>アプリ一覧へ戻る</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        </div>

        <!-- KPI Hero Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6 mb-12 reveal-on-scroll">
            <div class="liquid-card !p-6 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold text-secondary uppercase tracking-wider">全世界累計ダウンロード</span>
                    <span class="w-8 h-8 rounded-full bg-accent/15 text-accent flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                        </svg>
                    </span>
                </div>
                <div>
                    <div class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary">
                        {totalDownloads.toLocaleString()}
                    </div>
                    <div class="text-xs text-secondary mt-1">
                        国内 {jpDownloads.toLocaleString()} / 海外 {overseasDownloads.toLocaleString()} DL
                    </div>
                </div>
            </div>

            <div class="liquid-card !p-6 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold text-secondary uppercase tracking-wider">グローバル展開・アプリ数</span>
                    <span class="w-8 h-8 rounded-full bg-emerald-500/15 text-emerald-500 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </span>
                </div>
                <div>
                    <div class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary">
                        {totalCountriesCount} <span class="text-lg font-semibold text-secondary">カ国・地域</span>
                    </div>
                    <div class="text-xs text-secondary mt-1">全 {totalApps} アプリ（海外比率 {overseasSharePct}%）</div>
                </div>
            </div>

            <div class="liquid-card !p-6 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold text-secondary uppercase tracking-wider">グローバル平均スコア</span>
                    <span class="w-8 h-8 rounded-full bg-amber-500/15 text-amber-500 flex items-center justify-center">
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                    </span>
                </div>
                <div>
                    <div class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary">
                        ★ {averageRating.toFixed(2)}
                    </div>
                    <div class="text-xs text-secondary mt-1">世界各国の加重平均（5点満点）</div>
                </div>
            </div>

            <div class="liquid-card !p-6 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold text-secondary uppercase tracking-wider">総評価・レビュー件数</span>
                    <span class="w-8 h-8 rounded-full bg-violet-500/15 text-violet-500 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                    </span>
                </div>
                <div>
                    <div class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary">
                        {totalRatings.toLocaleString()} <span class="text-lg font-semibold text-secondary">件</span>
                    </div>
                    <div class="text-xs text-secondary mt-1">テキストレビュー {totalReviewsCount.toLocaleString()} 件収録</div>
                </div>
            </div>
        </div>

        <!-- Global Country & Territory Breakdown Section -->
        {
            sortedCountries.length > 0 && (
                <div class="liquid-card mb-12 reveal-on-scroll">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
                        <div>
                            <h2 class="text-xl sm:text-2xl font-bold text-primary">
                                世界各国・地域別ダウンロード分布（全 {totalCountriesCount} カ国・地域）
                            </h2>
                            <p class="text-xs sm:text-sm text-secondary">
                                日本国内（{jpDownloads.toLocaleString()} DL）と海外（{overseasDownloads.toLocaleString()} DL / {overseasSharePct}%）の国別内訳
                            </p>
                        </div>
                        <div class="flex items-center gap-3 text-xs font-semibold shrink-0">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/15 text-blue-600 dark:text-blue-400">
                                🇯🇵 日本 {(100 - Number(overseasSharePct)).toFixed(1)}%
                            </span>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
                                🌐 海外 {overseasSharePct}%
                            </span>
                        </div>
                    </div>

                    <!-- Top 12 Countries Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 mb-5">
                        {sortedCountries.slice(0, 12).map((c, idx) => {
                            const pct =
                                totalTrackedCountryDownloads > 0
                                    ? ((c.downloads / totalTrackedCountryDownloads) * 100).toFixed(1)
                                    : "0.0";
                            return (
                                <div class="p-3.5 rounded-2xl bg-black/[0.02] dark:bg-white/[0.04] border border-black/5 dark:border-white/5 flex items-center justify-between gap-2">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <span class="text-lg shrink-0">{countryCodeToFlag(c.code)}</span>
                                        <div class="min-w-0">
                                            <div class="text-xs font-bold text-primary truncate">
                                                {getCountryName(c.code)}
                                            </div>
                                            <div class="text-[10px] text-secondary">
                                                #{idx + 1} ・ {pct}%
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-xs sm:text-sm font-extrabold text-primary font-mono shrink-0">
                                        {c.downloads.toLocaleString()}
                                    </div>
                                </div>
                            );
                        })}
                    </div>

                    <!-- Remaining Countries Pill Cloud -->
                    {sortedCountries.length > 12 && (
                        <details class="group">
                            <summary class="text-xs font-semibold text-accent cursor-pointer hover:underline select-none">
                                すべての国・地域を表示（他 {sortedCountries.length - 12} カ国・地域） ↓
                            </summary>
                            <div class="mt-4 flex flex-wrap gap-2 p-4 rounded-2xl bg-black/[0.02] dark:bg-white/[0.03]">
                                {sortedCountries.slice(12).map((c) => (
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/[0.04] dark:bg-white/[0.07] text-xs">
                                        <span>{countryCodeToFlag(c.code)}</span>
                                        <span class="font-medium text-primary">{getCountryName(c.code)}</span>
                                        <span class="font-mono text-secondary">{c.downloads.toLocaleString()}</span>
                                    </span>
                                ))}
                            </div>
                        </details>
                    )}
                </div>
            )
        }

        <!-- Download Share Distribution Bar -->
        <div class="liquid-card mb-12 reveal-on-scroll">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-primary">アプリ別ダウンロード構成比（シェア）</h2>
                    <p class="text-xs sm:text-sm text-secondary">全アプリの総ダウンロード数（{totalDownloads.toLocaleString()} DL）に対する上位アプリの割合</p>
                </div>
            </div>

            <!-- Stacked Bar -->
            <div class="h-5 w-full rounded-full overflow-hidden flex bg-black/5 dark:bg-white/10 mb-5 p-0.5 gap-0.5">
                {
                    top5Apps.map((app: any, i: number) => {
                        const pct = totalDownloads > 0 ? ((app.downloads || 0) / totalDownloads) * 100 : 0;
                        return (
                            <div
                                class={`${palette[i]} h-full first:rounded-l-full transition-all duration-700`}
                                style={`width: ${Math.max(pct, 1.5).toFixed(2)}%`}
                                title={`${app.name}: ${(app.downloads || 0).toLocaleString()} DL (${pct.toFixed(1)}%)`}
                            />
                        );
                    })
                }
                {
                    othersDownloads > 0 && (
                        <div
                            class={`${palette[5]} h-full rounded-r-full`}
                            style={`width: ${((othersDownloads / totalDownloads) * 100).toFixed(2)}%`}
                            title={`その他 (${totalApps - 5}本): ${othersDownloads.toLocaleString()} DL`}
                        />
                    )
                }
            </div>

            <!-- Legend -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                {
                    top5Apps.map((app: any, i: number) => {
                        const pct = totalDownloads > 0 ? ((app.downloads || 0) / totalDownloads) * 100 : 0;
                        return (
                            <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-black/[0.02] dark:bg-white/[0.04]">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <span class={`w-3 h-3 rounded-full shrink-0 ${palette[i]}`}></span>
                                    <span class="text-xs font-semibold text-primary truncate">{app.name}</span>
                                </div>
                                <div class="text-xs text-secondary shrink-0 font-mono">
                                    {(app.downloads || 0).toLocaleString()} ({pct.toFixed(1)}%)
                                </div>
                            </div>
                        );
                    })
                }
                <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-black/[0.02] dark:bg-white/[0.04]">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <span class={`w-3 h-3 rounded-full shrink-0 ${palette[5]}`}></span>
                        <span class="text-xs font-semibold text-primary truncate">その他 ({Math.max(0, totalApps - 5)}本)</span>
                    </div>
                    <div class="text-xs text-secondary shrink-0 font-mono">
                        {othersDownloads.toLocaleString()} ({totalDownloads > 0 ? ((othersDownloads / totalDownloads) * 100).toFixed(1) : "0.0"}%)
                    </div>
                </div>
            </div>
        </div>

        <!-- Top 10 Apps Bar Chart & Milestone Tiers -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
            <!-- Top 10 Downloads Ranking -->
            <div class="lg:col-span-2 liquid-card reveal-on-scroll">
                <div class="mb-6">
                    <h2 class="text-xl sm:text-2xl font-bold text-primary mb-1">ダウンロード数 TOP 10</h2>
                    <p class="text-xs sm:text-sm text-secondary">クリックすると各アプリの国別内訳・概要・全世界レビューを表示します</p>
                </div>

                <div class="space-y-4">
                    {
                        topApps.map((app: any, idx: number) => {
                            const ratio = Math.sqrt((app.downloads || 0) / maxAppDownloads) * 100;
                            const pctOfTotal = totalDownloads > 0 ? (((app.downloads || 0) / totalDownloads) * 100).toFixed(1) : "0.0";
                            const appCountryCount = Object.keys(app.countries || {}).length;
                            return (
                                <div
                                    class="group p-3.5 rounded-2xl bg-black/[0.02] dark:bg-white/[0.03] hover:bg-black/[0.05] dark:hover:bg-white/[0.07] transition-colors cursor-pointer"
                                    data-app-card
                                    data-app-detail={JSON.stringify({
                                        name: app.name,
                                        description: app.description,
                                        iconUrl: app.iconPlaceholder,
                                        appStoreUrl: app.appStoreLink,
                                        features: app.features || [],
                                        images: app.images || [],
                                        genre: app.genre,
                                        releaseDate: app.releaseDate,
                                        version: app.version,
                                        rank: idx + 1,
                                        rating: app.rating,
                                        ratingCount: app.ratingCount,
                                        downloads: app.downloads,
                                        countries: app.countries || {},
                                        reviews: app.reviews || [],
                                    })}
                                >
                                    <div class="flex items-center gap-3.5 mb-2">
                                        <span class={`w-6 text-center text-xs font-extrabold ${idx < 3 ? "text-accent" : "text-secondary"}`}>
                                            #{idx + 1}
                                        </span>
                                        {app.iconPlaceholder && (
                                            <img
                                                src={app.iconPlaceholder}
                                                alt={app.name}
                                                class="w-10 h-10 rounded-[22%] object-cover shadow-sm shrink-0"
                                                loading="lazy"
                                            />
                                        )}
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center justify-between gap-2">
                                                <h3 class="text-sm sm:text-base font-bold text-primary truncate group-hover:text-accent transition-colors">
                                                    {app.name}
                                                </h3>
                                                <span class="text-sm sm:text-base font-extrabold text-primary shrink-0 font-mono">
                                                    {(app.downloads || 0).toLocaleString()} <span class="text-xs font-normal text-secondary">DL</span>
                                                </span>
                                            </div>
                                            <div class="flex items-center justify-between text-[11px] text-secondary mt-0.5">
                                                <span>
                                                    {app.genre || "App"}
                                                    {appCountryCount > 0 ? ` ・ 🌐 ${appCountryCount}カ国` : ""}
                                                    {app.rating && app.ratingCount > 0 ? ` ・ ★ ${app.rating.toFixed(1)} (${app.ratingCount})` : ""}
                                                </span>
                                                <span>全体の {pctOfTotal}%</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="w-full h-2 rounded-full bg-black/5 dark:bg-white/10 overflow-hidden">
                                        <div
                                            class="h-full rounded-full bg-gradient-to-r from-blue-500 to-indigo-500 transition-all duration-700"
                                            style={`width: ${Math.max(ratio, 3).toFixed(1)}%`}
                                        />
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>
            </div>

            <!-- Right Column: Genres & Tiers -->
            <div class="flex flex-col gap-8">
                <!-- Genre Breakdown -->
                <div class="liquid-card reveal-on-scroll">
                    <h2 class="text-xl font-bold text-primary mb-1">カテゴリ別集計</h2>
                    <p class="text-xs text-secondary mb-5">App Store ジャンル別の本数と総DL数</p>
                    <div class="space-y-3.5">
                        {
                            genres.map((g) => {
                                const dlPct = totalDownloads > 0 ? (g.downloads / totalDownloads) * 100 : 0;
                                return (
                                    <div class="p-3 rounded-xl bg-black/[0.02] dark:bg-white/[0.04]">
                                        <div class="flex items-center justify-between text-xs sm:text-sm font-bold text-primary mb-1">
                                            <span>{g.name}</span>
                                            <span class="font-mono">{g.downloads.toLocaleString()} DL</span>
                                        </div>
                                        <div class="flex items-center justify-between text-[11px] text-secondary mb-2">
                                            <span>{g.count} アプリ</span>
                                            <span>{dlPct.toFixed(1)}%</span>
                                        </div>
                                        <div class="w-full h-1.5 rounded-full bg-black/5 dark:bg-white/10 overflow-hidden">
                                            <div
                                                class="h-full rounded-full bg-accent"
                                                style={`width: ${Math.max(dlPct, 2).toFixed(1)}%`}
                                            />
                                        </div>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>

                <!-- Download Milestone Tiers -->
                <div class="liquid-card reveal-on-scroll">
                    <h2 class="text-xl font-bold text-primary mb-1">DL規模別アプリ数</h2>
                    <p class="text-xs text-secondary mb-5">ダウンロード数のマイルストーン分布</p>
                    <div class="grid grid-cols-2 gap-3">
                        {
                            tiers.map((t) => (
                                <div class="p-4 rounded-2xl bg-black/[0.02] dark:bg-white/[0.04] flex flex-col justify-between">
                                    <span class="text-xs font-semibold text-secondary">{t.label}</span>
                                    <div class={`text-2xl sm:text-3xl font-extrabold mt-2 ${t.color}`}>
                                        {t.count} <span class="text-xs font-normal text-secondary">本</span>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Yearly Release Timeline -->
        {
            yearlyStats.length > 0 && (
                <div class="liquid-card mb-12 reveal-on-scroll">
                    <div class="mb-6">
                        <h2 class="text-xl sm:text-2xl font-bold text-primary mb-1">年別リリース推移</h2>
                        <p class="text-xs sm:text-sm text-secondary">各年にリリースしたアプリ本数と、その年に生まれたアプリの累計DL数</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                        {yearlyStats.map((y) => {
                            const barPct = (y.count / maxYearlyCount) * 100;
                            return (
                                <div class="p-4 rounded-2xl bg-black/[0.02] dark:bg-white/[0.04] border border-black/5 dark:border-white/5 flex flex-col justify-between">
                                    <div>
                                        <div class="flex items-baseline justify-between mb-2">
                                            <span class="text-lg font-extrabold text-primary">{y.year}年</span>
                                            <span class="text-xs font-bold text-accent">{y.count}本リリース</span>
                                        </div>
                                        <div class="w-full h-2 rounded-full bg-black/5 dark:bg-white/10 overflow-hidden mb-3">
                                            <div class="h-full rounded-full bg-emerald-500" style={`width: ${barPct}%`} />
                                        </div>
                                        <div class="text-xs text-secondary mb-3">
                                            累計 <span class="font-bold text-primary font-mono">{y.downloads.toLocaleString()}</span> DL
                                        </div>
                                    </div>
                                    <div class="flex flex-wrap gap-1.5 pt-2 border-t border-black/5 dark:border-white/5">
                                        {y.apps.slice(0, 8).map((a: any) =>
                                            a.iconPlaceholder ? (
                                                <img
                                                    src={a.iconPlaceholder}
                                                    alt={a.name}
                                                    title={`${a.name} (${(a.downloads || 0).toLocaleString()} DL)`}
                                                    class="w-6 h-6 rounded-md object-cover shadow-xs"
                                                    loading="lazy"
                                                />
                                            ) : null
                                        )}
                                        {y.apps.length > 8 && (
                                            <span class="text-[10px] text-secondary self-center">+{y.apps.length - 8}</span>
                                        )}
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                </div>
            )
        }

        <!-- Complete Table of All Apps -->
        <div class="liquid-card reveal-on-scroll">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-primary">全アプリ実績一覧テーブル</h2>
                    <p class="text-xs sm:text-sm text-secondary">行をクリックすると国別DL内訳や全レビューを含む詳細ポップアップが開きます</p>
                </div>
            </div>

            <div class="overflow-x-auto -mx-4 sm:mx-0">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-black/10 dark:border-white/10 text-[11px] font-bold text-secondary uppercase tracking-wider">
                            <th class="py-3 px-4">#</th>
                            <th class="py-3 px-4">アプリ名</th>
                            <th class="py-3 px-4 hidden sm:table-cell">カテゴリ</th>
                            <th class="py-3 px-4 text-right">ダウンロード数</th>
                            <th class="py-3 px-4 text-right hidden sm:table-cell">配信国数</th>
                            <th class="py-3 px-4 text-right">評価 / レビュー</th>
                            <th class="py-3 px-4 text-right hidden md:table-cell">リリース日</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 dark:divide-white/5 text-xs sm:text-sm">
                        {
                            apps.map((app: any, idx: number) => {
                                const appCountries = Object.keys(app.countries || {}).length;
                                const revCount = (app.reviews || []).length;
                                return (
                                    <tr
                                        class="hover:bg-black/[0.03] dark:hover:bg-white/[0.05] transition-colors cursor-pointer group"
                                        data-app-card
                                        data-app-detail={JSON.stringify({
                                            name: app.name,
                                            description: app.description,
                                            iconUrl: app.iconPlaceholder,
                                            appStoreUrl: app.appStoreLink,
                                            features: app.features || [],
                                            images: app.images || [],
                                            genre: app.genre,
                                            releaseDate: app.releaseDate,
                                            version: app.version,
                                            rank: idx + 1,
                                            rating: app.rating,
                                            ratingCount: app.ratingCount,
                                            downloads: app.downloads,
                                            countries: app.countries || {},
                                            reviews: app.reviews || [],
                                        })}
                                    >
                                        <td class="py-3 px-4 font-bold text-secondary">#{idx + 1}</td>
                                        <td class="py-3 px-4">
                                            <div class="flex items-center gap-3">
                                                {app.iconPlaceholder && (
                                                    <img
                                                        src={app.iconPlaceholder}
                                                        alt={app.name}
                                                        class="w-8 h-8 rounded-[22%] object-cover shrink-0 shadow-xs"
                                                        loading="lazy"
                                                    />
                                                )}
                                                <span class="font-bold text-primary group-hover:text-accent transition-colors line-clamp-1">
                                                    {app.name}
                                                </span>
                                            </div>
                                        </td>
                                        <td class="py-3 px-4 text-secondary hidden sm:table-cell">
                                            {app.genre || "-"}
                                        </td>
                                        <td class="py-3 px-4 text-right font-extrabold text-primary font-mono">
                                            {(app.downloads || 0).toLocaleString()}
                                        </td>
                                        <td class="py-3 px-4 text-right text-secondary hidden sm:table-cell font-mono">
                                            {appCountries > 0 ? `${appCountries}カ国` : "-"}
                                        </td>
                                        <td class="py-3 px-4 text-right text-secondary font-mono">
                                            {app.rating && app.ratingCount > 0 ? (
                                                <span>
                                                    <span class="text-amber-500">★</span> {app.rating.toFixed(1)}{" "}
                                                    <span class="text-[11px] opacity-75">
                                                        ({app.ratingCount}{revCount > 0 ? ` / 💬${revCount}` : ""})
                                                    </span>
                                                </span>
                                            ) : (
                                                "-"
                                            )}
                                        </td>
                                        <td class="py-3 px-4 text-right text-secondary hidden md:table-cell font-mono text-xs">
                                            {app.releaseDate
                                                ? new Date(app.releaseDate).toLocaleDateString("ja-JP", {
                                                      year: "numeric",
                                                      month: "2-digit",
                                                      day: "2-digit",
                                                  })
                                                : "-"}
                                        </td>
                                    </tr>
                                );
                            })
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</Layout>
